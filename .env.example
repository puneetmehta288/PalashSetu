# BhashaSetu Configuration
APP_NAME=BhashaSetu
APP_VERSION=1.0.0

# Backend
HOST=0.0.0.0
PORT=8000
DATABASE_URL=sqlite:///./data/bhashasetu.db

# AI Providers (all have free defaults)
TRANSLATION_PROVIDER=indictrans2
ASR_PROVIDER=webspeech
TTS_PROVIDER=gtts
LLM_PROVIDER=template

# Model paths
MODELS_DIR=./models
CONTENT_DIR=./data/content
AUDIO_DIR=./data/audio

# Optional: HuggingFace token (needed for gated model download)
# HF_TOKEN=

# Optional: Cloud AI providers (not required for base app)
# OPENAI_API_KEY=
# GOOGLE_API_KEY=

# CORS
CORS_ORIGINS=*
