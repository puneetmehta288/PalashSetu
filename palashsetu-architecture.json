      {
        "id": "student-learning",
        "label": "Autonomous Student Learning",
        "focus": ["student_companion", "student_app", "student_learning", "content_store"],
        "note": "Students interact with 16 NIPUN FLN bilingual decks (96 cards), 8 full JCERT textbooks, and interactive practice worksheets with instant audio feedback."
      },
      {
        "id": "offline-auth",
        "label": "Multi-Teacher Scoped PIN Storage & Attendance",
        "focus": ["teacher", "teacher_app", "local_db"],
        "note": "Local SHA-256 hashed 4-digit PIN authentication with multi-teacher scoped attendance registers and session storage entirely on-device."
      },
      {
        "id": "cloud-sync",
        "label": "Store-and-Forward Telemetry & Portal",
        "focus": ["teacher_app", "telemetry_svc", "vercel_hub"],
        "note": "Pedagogical usage and attendance logs are buffered in offline local storage; automatically batched and synced via HTTPS POST whenever intermittent network is detected."
      }
    ]
